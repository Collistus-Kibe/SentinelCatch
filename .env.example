# Database (TiDB Cloud MySQL URI, Neon, Supabase, Render, or local)
# TiDB Cloud example: mysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<dbname>?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Satellite Radar & AIS (Global Fishing Watch API token)
GFW_API_TOKEN=

# AI Reasoning - Google Gemini (Slot 1 & Slot 2 with automatic fallback/rotation)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# AI Reasoning - ChatGPT / OpenAI (Slot 1 & Slot 2 with automatic fallback/rotation)
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=

# AI Provider Mode: gemini | openai | hybrid (auto-failover between Gemini and ChatGPT)
LLM_PROVIDER=hybrid
LLM_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Real-time AIS Stream (aisstream.io key - optional)
AISSTREAM_API_KEY=

# Copernicus ESA Satellite Data (optional)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# MapTiler Basemap (optional - leave blank to use free ESRI tiles)
MAPTILER_KEY=

# Operational Settings
ALERT_SCORE_THRESHOLD=70
PIPELINE_INTERVAL_MINUTES=60
BACKFILL_DAYS=60
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
ACCESS_CODE=
